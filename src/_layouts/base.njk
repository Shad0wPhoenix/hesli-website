<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta property="og:site-name" content="Hesli" />
        <meta name="author" content="ShadowPhoenix" />
        <title>{{title}} - Hesli</title>
        <meta property="og:title" content="{{title}} - Hesli" />
        <meta name="description" content="{{excerpt}}" />
        <meta property="og:description" content="{{excerpt}}" />
        <meta property="og:image" content="" />
        <meta property="og:image:secure-url" content="" />

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap-grid.min.css" rel="stylesheet" />

        <link rel="stylesheet" href="{{ '/_styles/main.css' | url }}" />

        <script src="https://kit.fontawesome.com/653e38639f.js" crossorigin="anonymous"></script>
    </head>
    <body>
        {%- set navigation = collections.navGraph -%}
        {%- set currentNode = navigation.getNodeByStem(page.filePathStem) -%}
        {%- set ancestors = navigation.getActivePath(currentNode) -%}
        {%- set breadcrumbs = navigation.getBreadcrumbs(currentNode) -%}
        
        {%- from "partials/sidebar-nav.njk" import render -%}
        <div class="sidebar-nav">
            <script src="/_scripts/menuToggle.js"></script>
            <div class="navigation">
                <script src="/_scripts/navToggle.js"></script>
                {{ render(navigation.root, page, ancestors) }}
            </div>
        </div>

        <div class="content">
            {%- include "partials/header.njk" -%}
            <button id="menu-toggle"><i class="fa-solid fa-bars" id="menu-toggle"></i></button>
            <main class="page">
                {{ content | safe }}
            </main>

            {%- include "partials/tooltip.njk" -%}
            {%- include "partials/madeWithTavernRumours.njk" -%}
            <script src="/_scripts/secretToggle.js"></script>
        </div>
    </body>
</html>
