<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta property="og:site-name" content="Hesli" />
        <meta name="author" content="ShadowPhoenix" />
        <title>{{title}} - Hesli</title>
        <meta property="og:title" content="{{title}} - Hesli" />
        <meta name="description" content="{{description}}" />
        <meta property="og:description" content="{{description}}" />
        <meta property="og:image" content="" />
        <meta property="og:image:secure-url" content="" />

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap-grid.min.css" rel="stylesheet" />

        <link rel="stylesheet" href="{{ '/_styles/main.css' | url }}" />

        <script src="https://kit.fontawesome.com/653e38639f.js" crossorigin="anonymous"></script>
    </head>
    <body>
        {% set navigation = collections.navGraph %}
        {% set currentNode = navigation.getNodeByStem(page.filePathStem) %}
        {% set ancestors = navigation.getAncestors(currentNode) %}
        
        {% from "partials/sidebar.njk" import render %}
        <div class="sidebar-nav">
            {% if not homepage %}<a href="/" class="btn"><span class="left"></span><span class="right"></span>Home</a>{% endif %}
            {{ render(navigation.root, ancestors) }}
        </div>
        <div class="content">
            {% include "partials/header.njk" %}
            <main class="page">
                {{ content | safe }}
            </main>

            {% include "partials/tooltip.njk" %}
        </div>
    </body>
</html>