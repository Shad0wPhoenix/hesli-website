{%- set breadcrumbs = navigation.getBreadcrumbs(currentNode) -%}
<div class="breadcrumbs">
    <a href="/"><i class="fa-regular fa-house-chimney"></i></a>
    {%- for breadcrumb in breadcrumbs -%}
        &nbsp;&gt;&nbsp;
        {%- if breadcrumb.page -%}<a href="{{ breadcrumb.url }}">{{ breadcrumb.title }}</a>{%- else -%}{{ breadcrumb.title }}{%- endif -%}
    {%- endfor -%}
</div>